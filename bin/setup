#!/usr/bin/env ruby
# frozen_string_literal: true

# Set up the development environment (HO §126). Idempotent.
#
# Everything runs in containers. `migrate` runs once as healthos_migrator and
# exits; web and worker run as the unprivileged healthos_app, because
# migrations need CREATE and the application deliberately must not have it
# (ADR-002 Decision 4a).

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args) = system(*args, exception: true)

FileUtils.chdir APP_ROOT do
  puts "== Building the development image =="
  system! "docker compose build"

  puts "\n== Starting dependencies =="
  system! "docker compose up -d postgres minio"

  print "   waiting for postgres"
  40.times do
    status = `docker inspect --format='{{.State.Health.Status}}' healthos-postgres-1 2>/dev/null`.strip
    break if status == "healthy"

    print "."
    sleep 2
  end
  puts " ready"

  # Object lock can only be enabled at bucket creation (ADR-002 4b), so this
  # is not something to defer to a production runbook.
  puts "\n== Ensuring object storage buckets =="
  system! "docker compose run --rm minio_setup"

  # Roles are cluster-level and cannot come from a migration. The compose file
  # applies db/roles.sql on first initialisation of an empty volume; this
  # re-applies it idempotently for volumes that already exist.
  puts "\n== Ensuring database roles =="
  system! "docker compose exec -T postgres psql -q -U postgres -d postgres < db/roles.sql"

  puts "\n== Preparing databases =="
  system! "docker compose run --rm migrate"

  puts "\n== Done =="
  puts "   bin/dev                 start everything in containers"
  puts "   bin/dev --native        host Ruby against containerised deps"
  puts "   bin/test                run the suite on the host"
  puts "   bin/test --docker       run the suite in the container"
  puts "   docker compose exec web bin/rails console"
  puts "   docker compose run --rm web bin/rails demo:seed"
end
