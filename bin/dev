#!/usr/bin/env bash
# Start the development environment (HO §126).
#
# Containers are the default: web, worker, postgres and object storage all
# run in Docker, so what you run locally matches what CI and any future
# deployment run (HO §6.6). The worker is not optional — without it the
# outbox dispatcher never fires, and every cross-step side effect (S2C-021)
# silently does nothing while the app looks healthy.
#
#   bin/dev              containers (default)
#   bin/dev --native     host Ruby against containerised postgres/minio
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "--native" ]; then
  # Escape hatch for debugger-heavy work. Dependencies still run in Docker.
  docker compose up -d postgres minio
  trap 'kill 0' EXIT
  bin/jobs &
  exec bin/rails server
fi

exec docker compose up "$@"
