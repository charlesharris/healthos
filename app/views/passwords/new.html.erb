<% content_for :title, "Reset password" %>

<div class="doorway-card">
  <h1>Forgot your password?</h1>
  <p class="small muted" style="margin-bottom:0.9rem">
    We will email reset instructions to the address on your account.
  </p>

  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= label_tag :email_address, "Email" %>
      <%= form.email_field :email_address, id: "email_address", required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address] %>
    </div>

    <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
  <% end %>
</div>

<p class="doorway-foot"><%= link_to "Back to sign in", new_session_path %></p>
