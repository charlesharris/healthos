<% content_for :title, "Update password" %>

<div class="doorway-card">
  <h1>Update your password</h1>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="field">
      <%= label_tag :password, "New password" %>
      <%= form.password_field :password, id: "password", required: true, autofocus: true,
            autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="field">
      <%= label_tag :password_confirmation, "Repeat new password" %>
      <%= form.password_field :password_confirmation, id: "password_confirmation", required: true,
            autocomplete: "new-password", maxlength: 72 %>
      <p class="field-hint">Signing in again elsewhere will be required — this ends every active session.</p>
    </div>

    <%= form.submit "Save", class: "btn btn-primary" %>
  <% end %>
</div>
