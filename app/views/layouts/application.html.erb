<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <%# The working shell: a thin top bar carrying tenant and identity, a rail
        carrying the surfaces, and everything else given to the content. The
        app had no chrome at all before this — every page began with an <h1>
        floating at the top-left and no way to reach any other page. %>
    <div class="shell">
      <header class="topbar">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark" aria-hidden="true"></span>
          <span>healthos</span>
        <% end %>

        <span class="topbar-sep" aria-hidden="true">/</span>
        <%= render "layouts/organization_menu" %>

        <span class="spacer"></span>

        <%= render "layouts/user_menu" %>
      </header>

      <div class="shell-body">
        <%= render "layouts/rail" %>
        <main class="main"><%= yield %></main>
      </div>
    </div>
  </body>
</html>
