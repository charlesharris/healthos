<title><%= content_for(:title) ? "#{content_for(:title)} · Healthos" : "Healthos" %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Healthos">
<meta name="mobile-web-app-capable" content="yes">

<%# Both themes are declared so form controls, scrollbars and the browser's
    own chrome follow the page rather than sitting in the opposite theme. %>
<meta name="color-scheme" content="light dark">

<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
