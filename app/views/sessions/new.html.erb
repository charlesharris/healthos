<% content_for :title, "Sign in" %>

<div class="doorway-card">
  <h1>Sign in</h1>

  <%= form_with url: session_path do |form| %>
    <div class="field">
      <%= label_tag :email_address, "Email" %>
      <%= form.email_field :email_address, id: "email_address", required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address] %>
    </div>

    <div class="field">
      <%= label_tag :password, "Password" %>
      <%= form.password_field :password, id: "password", required: true,
            autocomplete: "current-password", maxlength: 72 %>
    </div>

    <%= form.submit "Sign in", class: "btn btn-primary" %>
  <% end %>
</div>

<p class="doorway-foot"><%= link_to "Forgot password?", new_password_path %></p>
