<div class="auth-card">
  <h1>Healthos</h1>
  <p class="muted" style="margin-bottom:1.1rem">Provider health observability</p>

  <% if flash[:alert] %><div class="flash flash-alert"><%= flash[:alert] %></div><% end %>
  <% if flash[:notice] %><div class="flash flash-notice"><%= flash[:notice] %></div><% end %>

  <%= form_with url: session_path do |form| %>
    <label for="email_address">Email</label>
    <%= form.email_field :email_address, id: "email_address", required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>

    <label for="password">Password</label>
    <%= form.password_field :password, id: "password", required: true,
          autocomplete: "current-password", maxlength: 72 %>

    <%= form.submit "Sign in" %>
  <% end %>

  <p class="muted"><%= link_to "Forgot password?", new_password_path %></p>
</div>
