<%# Quick Review (HO §88).

    Two renderings of one partial. Requested inside the queue's Turbo frame it
    is the drawer; requested directly it is a full page — which is what keeps
    /ops/cases/:id linkable, bookmarkable, and reachable with JavaScript off.
    Either way the same audited controller action produced it. %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag "case_drawer" do %>
    <%= render "ops/cases/review",
               case_record: @case_record,
               trigger_attachments: @trigger_attachments,
               other_attachments: @other_attachments,
               timeline: @timeline,
               timeline_truncated: @timeline_truncated,
               telemetry: @telemetry,
               cohort_baselines: @cohort_baselines,
               drawer: true %>
  <% end %>
<% else %>
  <% content_for :title, @case_record.title.presence || @case_record.case_type.humanize %>

  <nav class="breadcrumb">
    <%= link_to "Ops Queue", ops_cases_path %>
    <span aria-hidden="true">/</span>
    <span>Quick Review</span>
  </nav>

  <%= render "layouts/flash" %>

  <%= render "ops/cases/review",
             case_record: @case_record,
             trigger_attachments: @trigger_attachments,
             other_attachments: @other_attachments,
             timeline: @timeline,
             timeline_truncated: @timeline_truncated,
             telemetry: @telemetry,
             cohort_baselines: @cohort_baselines,
             drawer: false %>

  <p class="tiny faint" style="margin-top:1.5rem">
    Full investigation workbench arrives with Epic 004; Quick Review is the
    surface for now (HO §88).
  </p>
<% end %>
