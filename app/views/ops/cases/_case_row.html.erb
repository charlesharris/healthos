<%# One queue row (HO §84).

    Column order is the requirement, not decoration: work reason first and
    linked, subject identity second and opaque. The queue answers "what needs
    doing", not "who is sick".

    Everything is one line plus one subline. The previous version stacked two
    full-height lines in most cells and put a select plus two forms in the
    last one, which made every row ~130px tall and the queue unscannable. %>
<div id="<%= dom_id(case_record, :row) %>" role="row"
     class="<%= class_names("qrow", "qrow-closed" => case_record.resolved?) %>"
     data-queue-target="row"
     data-case-id="<%= case_record.id %>"
     data-action="click->queue#activate">

  <%# Review priority restated as position, so the queue can be scanned
      without reading a chip in every row. Single-hue emphasis, never a
      severity ramp (S2C-011). %>
  <span class="qrail qrail-<%= case_record.review_priority %>" aria-hidden="true"></span>

  <%# Operational policy, not evidence (S2C-011). Rendered as a word, never a
      number, and never used to colour or rank by evidence strength. %>
  <span class="qcell qcell-priority" role="cell">
    <%= priority_chip(case_record.review_priority) %>
  </span>

  <%# Primary: why this Case exists. Subject identity and program ride in the
      subline — present, findable, and visually subordinate. %>
  <span class="qcell qcell-reason" role="cell">
    <%= link_to case_record.title.presence || case_record.case_type.humanize,
                ops_case_path(case_record),
                class: "reason-title",
                data: { turbo_frame: "case_drawer", queue_target: "title",
                        action: "queue#select" } %>
    <span class="reason-sub">
      <%# An opaque handle, never a name or an MRN. Identity is PHI and
          requires a deliberate, audited read (HO §92). %>
      <%= subject_handle(case_record.subject) %>
      <span class="sep" aria-hidden="true">·</span>
      <span class="truncate"><%= case_record.case_type.humanize %></span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="truncate"><%= case_record.domain_key %></span>
    </span>
  </span>

  <span class="qcell qcell-status" role="cell"><%= status_chip(case_record.status) %></span>

  <%# Age is time since anyone looked, falling back to detection — the same
      thing the default sort orders by, so the column explains the order. The
      detection age is only worth a second line once they differ. %>
  <span class="qcell qcell-age" role="cell">
    <%= compact_age(case_record.last_reviewed_at || case_record.detected_at) %>
    <% if case_record.resolved? && case_record.resolved_at %>
      <span class="age-sub">closed <%= compact_age(case_record.resolved_at) %></span>
    <% elsif case_record.last_reviewed_at %>
      <span class="age-sub">det <%= compact_age(case_record.detected_at) %></span>
    <% end %>
  </span>

  <span class="qcell qcell-owner" role="cell">
    <% if case_record.owner %>
      <span class="owner truncate" title="<%= case_record.owner.email_address %>">
        <%= case_record.owner.email_address.split("@").first %>
      </span>
    <% else %>
      <span class="owner owner-none">unassigned</span>
    <% end %>
    <span class="owner-sub truncate"><%= case_record.team&.name || "no team" %></span>
  </span>

  <%# S2C-019: analysis state is shown but never hides the Case. `failed` and
      `insufficient_evidence` are distinct states and both stay actionable.
      Evidence strength is displayed but never sorted or coloured by
      (S2C-011) — hence a monochrome meter rather than a badge. %>
  <span class="qcell qcell-analysis" role="cell">
    <span class="analysis-stack">
      <%= analysis_chip(case_record.analysis_status) %>
      <%= evidence_meter(case_record.evidence_level) %>
    </span>
  </span>

  <%# HO §84 columns that Epic 003/004 will populate. Kept visible while empty
      rather than hidden: nothing has been computed yet, and a queue that hid
      the fact would look more analysed than it is. %>
  <span class="qcell qcell-quality" role="cell">
    <span class="analysis-stack">
      <%= qualitative(case_record.data_quality_state) %>
      <%= qualitative(case_record.baseline_maturity) %>
    </span>
  </span>

  <%# Assignment and triage inline, so the common moves do not need a page
      load. The response is a Turbo stream replacing this row (HO §87).
      Revealed on hover or focus — twenty permanently open selects is what
      made the old queue unreadable — but always keyboard reachable.

      A closed Case gets no action cell at all; its closing time rides in the
      Age column instead. %>
  <% if case_record.active? %>
    <span class="qcell qcell-actions" role="cell">
      <span class="rowactions">
        <%= form_with url: ops_case_assignment_path(case_record), method: :patch do %>
          <%= hidden_field_tag :row, "1" %>
          <%= select_tag "assignment[owner_id]",
                         options_from_collection_for_select(assignment_options.owners, :id, :email_address,
                                                            case_record.owner_id),
                         include_blank: "unassigned",
                         aria: { label: "Assign owner" } %>
          <%= submit_tag "Assign", class: "btn btn-sm" %>
        <% end %>

        <% if case_record.status == "new" %>
          <%= form_with url: ops_case_state_path(case_record), method: :patch do %>
            <%= hidden_field_tag :row, "1" %>
            <%= hidden_field_tag "state[to]", "triaged" %>
            <%= submit_tag "Triage", class: "btn btn-sm" %>
          <% end %>
        <% end %>
      </span>
    </span>
  <% end %>
</div>
