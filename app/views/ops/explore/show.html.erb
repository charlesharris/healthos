<%# Cohort-wide exploration.

    Where a heatmap earns its keep: one subject measuring daily cannot fill
    one, the whole program can, and "which subjects and which devices are in
    this region" is a question only the cohort can answer.

    Descriptive throughout. Nothing here is ranked, scored, or saved — see
    Ops::ExploreController for why that is a constraint rather than an
    omission. %>
<% content_for :title, "Explore" %>
<% base = { controller: "/ops/explore", action: "show",
            range_from: @range.from.to_date, range_to: @range.to.to_date,
            key: @telemetry.semantic_key } %>
<% base = base.merge(where: @telemetry.filters) if @telemetry.filters.present? %>
<% base = base.merge(baseline: @telemetry.baseline_mode) if @telemetry.cohort_baseline? %>
<% selected_base = @telemetry.selection.none? ? base : base.merge(@telemetry.selection.to_params) %>

<div class="page-head">
  <div>
    <h1>Explore</h1>
    <p class="page-sub">
      Every reading in <%= Current.organization.name %> on one pair of axes.
      Drag a region to see what is in it.
    </p>
  </div>
</div>

<%= render "layouts/flash" %>

<%= form_with url: url_for(controller: "/ops/explore", action: "show"), method: :get,
              class: "filterbar", data: { controller: "autosubmit" } do %>
  <div class="filter">
    <%= label_tag :key, "Measure" %>
    <%= select_tag :key,
                   options_for_select(@telemetry.available_keys.map { |key|
                     [ key.split(".").last.tr("_", " "), key ]
                   }, @telemetry.semantic_key),
                   data: { action: "change->autosubmit#submit" } %>
  </div>

  <div class="filterbar-divider" aria-hidden="true"></div>

  <div class="filter">
    <%= label_tag :range_from, "From" %>
    <%= date_field_tag :range_from, @range.from.to_date,
                       data: { action: "change->autosubmit#submit" } %>
  </div>
  <div class="filter">
    <%= label_tag :range_to, "To" %>
    <%= date_field_tag :range_to, @range.to.to_date,
                       data: { action: "change->autosubmit#submit" } %>
  </div>

  <div class="filterbar-divider" aria-hidden="true"></div>

  <div class="filter">
    <%= label_tag :split, "Split" %>
    <%= select_tag :split,
                   options_for_select(Ops::ExploreController::SPLITS.map { |k, v| [ v, k ] }, @split),
                   data: { action: "change->autosubmit#submit" } %>
  </div>

  <%= submit_tag "Apply", class: "btn btn-sm", data: { autosubmit_target: "submit" } %>

  <span class="spacer"></span>
  <span class="tiny faint">
    Range is capped at <%= Ops::ExploreController::MAX_DAYS %> days.
  </span>
<% end %>

<% if @telemetry.any_data? %>
  <%= render "ops/cases/scope", profile: @telemetry, base_path: selected_base, frame_id: nil %>

  <section class="section">
    <% if @panels.length > 1 %>
      <%# Small multiples. Honeycomb puts every event on one heatmap because
          everything it plots is duration_ms; mmHg and bpm on one axis would be
          the dual-axis chart, which invents a correlation from an arbitrary
          alignment of two scales. Panels share a colour scale always, and
          share the value axis whenever they are the same measure. %>
      <div class="panels">
        <% @panels.each do |panel| %>
          <figure class="panel">
            <figcaption class="panel-head">
              <span class="panel-title <%= "mono" if panel.sublabel %>"><%= panel.label %></span>
              <% if panel.sublabel %><span class="panel-sub"><%= panel.sublabel %></span><% end %>
              <span class="panel-count">
                <%= pluralize(panel.profile.cohort_cells.sum(&:count), "reading") %>
                · <%= pluralize(panel.profile.cohort_subject_count, "subject") %>
              </span>
              <%# Each panel drills into itself: the same region, scoped to the
                  facet you clicked. %>
              <% if panel.panel_filters.any? %>
                <%= link_to "focus",
                            scope_path(selected_base, @telemetry.filters, add: panel.panel_filters),
                            class: "panel-focus" %>
              <% end %>
            </figcaption>

            <%= render "ops/cases/distribution",
                       profile: panel.profile, base_path: base.except(:key),
                       key_param: :key, frame_id: nil,
                       density_max: @density_max, compact: true %>
          </figure>
        <% end %>
      </div>

      <div class="chart-legend">
        <span class="legend-item">
          reading density (shared across panels)
          <span class="legend-ramp">
            <% density_scale(@density_max).each do |band| %>
              <span class="legend-swatch" style="background: var(--viz-density-<%= band[:step] %>)"
                    title="<%= band[:low] == band[:high] ? band[:low] : "#{band[:low]}–#{band[:high]}" %> readings"></span>
            <% end %>
          </span>
          <span class="tnum">1–<%= @density_max %> readings</span>
        </span>
        <span class="legend-item muted">drag on any panel to select that region</span>
      </div>
    <% else %>
      <%= render "ops/cases/distribution",
                 profile: @telemetry, base_path: base.except(:key), key_param: :key,
                 frame_id: nil, density_max: @density_max %>
    <% end %>
  </section>

  <% if @telemetry.selection.none? %>
    <div class="empty-state">
      <strong>Drag a region on the chart.</strong>
      Everything inside it becomes the selection; everything outside becomes
      the baseline. The breakdown appears here.
    </div>
  <% else %>
    <%= render "ops/cases/dimensions", profile: @telemetry,
               base_path: selected_base, frame_id: nil %>
  <% end %>

  <%# The way out. Independent of whether a region is selected — having scoped
      to a subject is already reason enough to want their work, and gating this
      behind a drag hid it exactly when it was most useful.

      Nothing on this surface creates a Case: only a Monitor does (S2C-003). %>
  <% if @subject_cases&.any? %>
    <section class="section">
      <h2 class="section-title">Cases for this subject</h2>
      <div class="queue-wrap">
        <div class="queue" role="table" aria-label="Cases for the scoped subject">
          <%= render partial: "ops/cases/case_row", collection: @subject_cases, as: :case_record %>
        </div>
      </div>
    </section>
  <% elsif @telemetry.focused? %>
    <p class="tiny muted">
      No Case has been raised for this subject. Work reaches the queue through
      a Monitor, never from here (S2C-003).
    </p>
  <% else %>
    <p class="tiny muted">
      Something worth acting on? It reaches the queue through a Monitor, not
      from here — <%= link_to "open the Ops Queue", ops_cases_path %> to see
      what has already been raised.
    </p>
  <% end %>

<% else %>
  <div class="empty-state">
    <strong>No readings in this range.</strong>
    <%= Current.organization.name %> has no observed telemetry between
    <%= l(@range.from.to_date, format: :long) %> and
    <%= l(@range.to.to_date, format: :long) %>.
  </div>
<% end %>
