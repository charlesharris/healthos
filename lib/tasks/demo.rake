# frozen_string_literal: true

# Demo seed (HO §127, epic 001-13, epic 002 gate). Synthetic only —
# prototype-scope.md records that this system holds no real data.
#
# Two cohorts, for two different jobs.
#
#   The named cohort (DEMO-001…) is hand-authored with STATED GROUND TRUTH,
#   printed at the end. A queue you cannot check is a demo that can only ever
#   look impressive. Someone reading it should be able to ask "did the system
#   find what was actually injected, and nothing else" and get an answer.
#
#   The background cohort exists so the queue looks like work rather than a
#   fixture — filters, sort and pagination are meaningless over four rows.
#   Its subjects are drawn from the same generators, mostly quiet.
#
# HO §127 asks for 100+ subjects. DEMO_POPULATION sets it; the default is
# smaller because bin/setup runs this synchronously and a five-minute seed is
# a five-minute wait every time someone sets the project up.
DEMO_EMAIL = "operator@demo.test"
DEMO_PASSWORD = "healthos-demo-password"
DEMO_WINDOW_DAYS = 21

# Read at call time, not load time, so a caller can set it without reloading
# this file — which spec/demo/seed_ground_truth_spec.rb does, and which
# reloading would otherwise fill with constant-redefinition warnings.
def demo_population = Integer(ENV.fetch("DEMO_POPULATION", 40))

namespace :demo do
  desc "Seed a small synthetic population with one trajectory change"
  task seed: :environment do
    org = Organization.find_or_create_by!(slug: "demo-health") { |o| o.name = "Demo Health" }

    # A known operator, so `bin/setup` leaves you able to sign in. Credentials
    # are fixed and public on purpose: prototype-scope.md records that this
    # system holds synthetic data only, and a demo you cannot log into is not
    # a demo. Production supplies real accounts through invitations (HO §11).
    operator = User.find_or_create_by!(email_address: DEMO_EMAIL) do |u|
      u.password = DEMO_PASSWORD
      u.full_name = "Demo Operator"
    end

    OrganizationMembership.find_or_create_by!(organization: org, user: operator) do |m|
      # organization_admin so the demo covers invitations and member
      # management as well as the queue.
      m.role = "organization_admin"
    end

    # Platform staff too, so /admin and the provenance drilldown are reachable
    # without a second account.
    StaffMember.find_or_create_by!(user: operator) do |s|
      s.status = "active"
      s.note = "Created by demo:seed. Synthetic data only."
    end

    Team.find_or_create_by!(organization: org, name: "clinical")
    Team.find_or_create_by!(organization: org, name: "operations")

    source = Source.find_or_create_by!(organization: org, key: "synthetic-bp") do |s|
      s.source_type = "synthetic"
      s.display_name = "Synthetic BP feed"
    end

    as_of = Time.current.beginning_of_hour
    store = Storage::RawPayloadStore.instance

    # Ground truth, stated so the demo is interpretable. `expect` is what a
    # correct system should surface; anything else is a false positive and
    # worth chasing.
    #
    # STAT-003 and STAT-035 are why the last three exist: measurement
    # behaviour is first-class analyzable data, and an instrumentation change
    # outranks a biological reading of the same numbers. A demo containing
    # only genuine physiology would quietly teach the opposite.
    named_population = [
      { mrn: "DEMO-001", label: "genuine rise", baseline: 122, recent: 145,
        expect: "trajectory change" },
      { mrn: "DEMO-002", label: "stable", baseline: 118, recent: 119,
        expect: "nothing" },
      { mrn: "DEMO-003", label: "stable", baseline: 128, recent: 127,
        expect: "nothing" },
      { mrn: "DEMO-004", label: "genuine fall", baseline: 140, recent: 118,
        expect: "trajectory change" },
      # Stops reporting a week ago. The reading average over what remains is
      # unchanged, so a system that only watches values sees nothing — and
      # "the monitoring stopped" is the thing a provider most needs told.
      { mrn: "DEMO-005", label: "monitoring interruption", baseline: 126, recent: 126,
        silent_from: 7, expect: "measurement frequency change, NOT a biological finding" },
      # Switches from an automatic cuff to manual entry mid-window. Manual
      # readings run lower here, so the numbers look like improvement.
      # STAT-008/009: that is an instrumentation Finding, not a fall.
      # The switch must sit entirely inside the recent window. At day 9 it
      # bled two days into the baseline, so `manual_entry` appeared in both
      # profiles, the monitor saw no NEW method, and the demo produced a
      # trajectory Case with no instrumentation Signal beside it — the exact
      # false reading STAT-035 exists to prevent, generated by the seed rather
      # than caught by it.
      { mrn: "DEMO-006", label: "source switch artifact", baseline: 138, recent: 124,
        method_switch_from: 7, expect: "source change beside the apparent fall" },
      # Two readings, both high. STAT-012's completeness gate should suppress
      # a biological claim rather than call it a strong signal.
      { mrn: "DEMO-007", label: "too sparse to judge", baseline: 150, recent: 152,
        only_days: [ 2, 11 ], expect: "nothing (completeness gate)" }
    ]

    # Background cohort: same generators, mostly quiet, deterministic per MRN.
    background = (1..demo_population).map do |i|
      mrn = format("BG-%03d", i)
      rng = Random.new(Digest::SHA256.hexdigest(mrn).to_i(16) % 2**32)
      baseline = rng.rand(112..136)

      # ~1 in 8 genuinely changes. Enough that the queue is not empty; few
      # enough that the named cohort stays the interpretable part.
      recent = i % 8 == 3 ? baseline + rng.rand(16..24) : baseline + rng.rand(-2..2)
      { mrn: mrn, label: "background", baseline: baseline, recent: recent, quiet: true }
    end

    def emit_readings(person, org:, source:, store:, as_of:)
      days = person[:only_days] || (1..DEMO_WINDOW_DAYS).to_a

      days.each do |days_ago|
        # A monitoring interruption is an ABSENCE of rows, not a row saying
        # zero. STAT-002: missing is never imputed, so the seed must actually
        # withhold the data rather than mark it.
        next if person[:silent_from] && days_ago <= person[:silent_from]

        rng = Random.new(Digest::SHA256.hexdigest("#{person[:mrn]}:#{days_ago}").to_i(16) % 2**32)
        systolic = (days_ago <= 6 ? person[:recent] : person[:baseline]) + rng.rand(-4..4)

        method = if person[:method_switch_from] && days_ago <= person[:method_switch_from]
                   "manual_entry"
        else
                   "device_automatic"
        end

        payload = {
          subject_identifier: { system: "mrn", value: person[:mrn] },
          recorded_at: (as_of - days_ago.days).iso8601,
          systolic: systolic, diastolic: systolic - 58, pulse: 68 + rng.rand(-5..5),
          recording_method: method
        }.to_json

        envelope = Ingestion::Receive.call(
          source: source, payload: payload,
          source_record_id: "#{person[:mrn]}-#{days_ago}", store: store
        ).envelope

        Normalization::NormalizeEnvelope.call(envelope: envelope, store: store)
      end
    end

    (named_population + background).each do |person|
      puts "  #{person[:mrn]} (#{person[:label]})" unless person[:quiet]
      emit_readings(person, org: org, source: source, store: store, as_of: as_of)
    end
    puts "  #{background.size} background subjects"

    puts "\n== Deriving daily summaries =="
    Subject.where(organization: org).find_each do |subject|
      (1..DEMO_WINDOW_DAYS).each do |days_ago|
        Derivation::ComputeDailySummary.call(
          subject: subject, semantic_key: "health.vital.blood_pressure.systolic",
          date: (as_of - days_ago.days).to_date
        )
      end
    end

    # Every monitor, not just trajectory. Running one monitor was what made
    # the earlier seed quietly misleading: the interruption and source-switch
    # subjects would have looked like clean data.
    puts "== Running monitors =="
    Subject.where(organization: org).find_each do |subject|
      Monitoring::Monitor.all.each do |monitor_key|
        result = Monitoring::EvaluateMonitor.call(
          subject: subject, monitor_key: monitor_key, as_of: as_of
        )
        next unless result.triggered?

        Cases::CorrelateSignal.call(signal: result.signal)
      end
    end

    seed_lifecycle_states(org: org, operator: operator, source: source, store: store, as_of: as_of)

    puts "\n== Seeded =="
    # SC §66's precondition: subject-level features are computed FIRST. The
    # cohort surfaces read materialized baselines rather than building 47 of
    # them inside a page render, so a demo without them shows an empty cohort
    # and looks like a bug.
    puts "\n== Baselines =="
    Analysis::ContextDefinition.declared_key_order.each do |semantic_key|
      outcome = Baselines::MaterializeCohort.call(
        organization: org, semantic_key: semantic_key, as_of: as_of
      )
      next if outcome.total.zero?

      puts "  #{semantic_key.split('.').last.ljust(12)} #{outcome.created} created, " \
           "#{outcome.existing} already present#{outcome.skipped.positive? ? ", #{outcome.skipped} skipped" : ''}"
    end

    puts "\n== Population =="
    puts "  subjects:     #{Subject.where(organization: org).count}"
    puts "  observations: #{Observation.where(organization: org).count}"
    puts "  signals:      #{Monitoring::Signal.where(organization: org).count}"
    puts "  cases:        #{Cases::CaseRecord.where(organization: org).count}"
    Cases::CaseRecord.where(organization: org).group(:status).count.sort.each do |status, count|
      puts "    #{status.ljust(18)} #{count}"
    end

    puts "\n== Ground truth =="
    named_population.each { |p| puts "  #{p[:mrn]}  #{p[:expect]}" }
    puts "  Anything else in the named cohort is a false positive worth chasing."

    puts "\n== Sign in =="
    puts "  #{DEMO_EMAIL} / #{DEMO_PASSWORD}"
    puts "  organization_admin + platform staff. Queue: /  Admin: /admin"
  end

  # The epic 002 gate asks the demo to cover the lifecycle, not just detection:
  # a Case someone parked with a watch, and a Case that came back.
  #
  # Both are produced by driving the real services — Transition, then a genuine
  # later Signal through CorrelateSignal — rather than by writing statuses
  # directly. A seed that sets `status: "resolved"` by hand produces a Case
  # with no disposition and an empty timeline, which is exactly the shape the
  # invariants forbid, and it would make the demo lie about what the system
  # does.
  def seed_lifecycle_states(org:, operator:, source:, store:, as_of:)
    puts "\n== Lifecycle states =="

    # Re-running the seed must not keep resolving and watching more Cases
    # until the queue is empty. Timelines are append-only, so there is no
    # tidying up after the fact — the guard has to be before the write.
    if Cases::CaseRecord.where(organization: org, status: %w[watching resolved]).exists?
      puts "  already present — skipping (re-run of an existing demo org)"
      return
    end

    watched = Cases::CaseRecord.where(organization: org, status: "new").order(:detected_at).first
    if watched
      Cases::Transition.call(
        case_record: watched, to: "watching", actor: operator,
        watch: { condition_type: "time_elapsed", parameters: {},
                 expires_at: 3.days.from_now }
      )
      puts "  watching:  #{watched.public_id} (time_elapsed, 3 days)"
    end

    # The target must be a subject with no excursion Signal yet. S2C-002
    # deduplicates on (organization, deduplication_key), so re-evaluating the
    # same monitor over the same day-aligned window returns the EXISTING
    # Signal — already attached, no reopen, and a demo that silently claims
    # one. Picking a clean subject makes the new Signal genuinely new.
    already_excursed = Monitoring::Signal
      .where(organization: org, signal_type: "threshold_excursion")
      .select(:subject_id)

    reopen_target = Cases::CaseRecord
      .where(organization: org, status: "new", case_type: "blood_pressure_change")
      .where.not(id: watched&.id)
      .where.not(subject_id: already_excursed)
      .order(:detected_at)
      .first

    if reopen_target.nil?
      puts "  reopen NOT produced — no eligible Case without an existing excursion Signal"
      return
    end

    Cases::Transition.call(
      case_record: reopen_target, to: "resolved", actor: operator,
      disposition: { code: "action_taken", notes: "Medication reviewed; recheck scheduled." }
    )

    # Genuinely new readings, monitored afresh — so the reopen happens for the
    # reason S2C-016 says it should, and the CaseEvent explains itself.
    #
    # Three of them, above the excursion band. The monitor requires
    # `minimum_excursions` before it will speak, which is the point: one high
    # reading is not an episode, and seeding a single value would have
    # produced no Signal and a silently unmet gate.
    subject = reopen_target.subject
    mrn_identifier = subject.subject_identifiers.first&.value || subject.public_id
    later = as_of + 1.hour

    # Yesterday, not today. Monitor windows are day-aligned and half-open, so
    # the current incomplete day is deliberately outside them — readings
    # stamped "now" produce no Signal at all. Worth stating: it is the kind of
    # off-by-one-day that makes a seed look broken when the monitor is right.
    3.times do |i|
      recorded_at = later - 1.day - i.hours
      payload = {
        subject_identifier: { system: "mrn", value: mrn_identifier },
        recorded_at: recorded_at.iso8601, systolic: 168 + i, diastolic: 104, pulse: 84,
        recording_method: "device_automatic"
      }.to_json

      envelope = Ingestion::Receive.call(
        source: source, payload: payload,
        source_record_id: "#{mrn_identifier}-reopen-#{i}", store: store
      ).envelope
      Normalization::NormalizeEnvelope.call(envelope: envelope, store: store)
    end

    Derivation::ComputeDailySummary.call(
      subject: subject, semantic_key: "health.vital.blood_pressure.systolic",
      date: (later - 1.day).to_date
    )

    result = Monitoring::EvaluateMonitor.call(
      subject: subject, monitor_key: "blood_pressure_threshold_excursion", as_of: later
    )
    if result.triggered?
      outcome = Cases::CorrelateSignal.call(signal: result.signal)
      puts "  reopened:  #{outcome.case_record.public_id} (#{outcome.outcome})"
    else
      # Said out loud rather than swallowed: a silent no-op here would leave
      # the gate looking met when it is not.
      puts "  reopen NOT produced — no excursion Signal fired for #{reopen_target.public_id}"
    end
  end

  # Deleting the demo organization is not something the application role can
  # do, and that is the design working: raw envelopes, Signals, CaseEvents and
  # audit rows are append-only by privilege revocation (ADR-002 4a), so
  # `bin/rails demo:reset` under the app user fails with a permission error
  # rather than quietly succeeding.
  #
  #   docker compose run --rm -e HEALTHOS_DB_USER=healthos_migrator web bin/rails demo:reset
  #
  # Development and test only. Guarded below, because a task that erases an
  # organization must not be one keystroke away from doing it in production.
  desc "Delete the demo organization and everything in it (dev/test only, migrator role)"
  task reset: :environment do
    unless Rails.env.local?
      abort "demo:reset refuses to run in #{Rails.env}."
    end

    org = Organization.find_by(slug: "demo-health")
    if org.nil?
      puts "No demo organization."
      next
    end

    # Deletion order is derived from the schema's foreign keys rather than
    # hand-maintained. A hand-written list is wrong the moment someone adds a
    # table, and it fails as a confusing FK violation halfway through a
    # delete — which is exactly what happened while writing this.
    conn = ActiveRecord::Base.connection
    tables = conn.tables.select { |t| conn.column_exists?(t, :organization_id) }

    dependencies = tables.to_h do |table|
      [ table, conn.foreign_keys(table).map(&:to_table).select { |t| tables.include?(t) } - [ table ] ]
    end

    ordered = []
    until dependencies.empty?
      # Tables nothing left in the set depends on come first.
      leaves = dependencies.keys.reject do |table|
        dependencies.except(table).values.any? { |deps| deps.include?(table) }
      end
      # A cycle would loop forever; there are none today, and if one appears
      # this says so instead of hanging.
      raise "cycle in foreign keys among #{dependencies.keys.join(', ')}" if leaves.empty?

      ordered.concat(leaves)
      dependencies.except!(*leaves)
    end

    deleted = ordered.sum do |table|
      conn.delete("DELETE FROM #{conn.quote_table_name(table)} WHERE organization_id = #{conn.quote(org.id)}")
    end

    org.delete
    puts "Deleted #{deleted} row(s) across #{ordered.size} table(s), and the organization."
  end

  desc "Re-run normalization for one envelope: rake 'demo:replay[env_public_id]'"
  task :replay, [ :public_id ] => :environment do |_t, args|
    envelope = RawEnvelope.find_by!(public_id: args[:public_id])

    puts "Replaying #{envelope.public_id} (#{envelope.adapter_key}@v#{envelope.adapter_version})"
    result = Normalization::NormalizeEnvelope.call(envelope: envelope)

    if result.created?
      puts "  normalized: #{result.observations.size} observation(s)"
    else
      # HO §96: re-running the same normalizer version is a no-op by design.
      # New rows require a new version (HO §155).
      puts "  no-op (#{result.skipped_reason}) — already normalized at this normalizer version"
    end
  end
end
