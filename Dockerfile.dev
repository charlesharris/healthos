# syntax=docker/dockerfile:1

# Development image.
#
# Separate from the production Dockerfile on purpose. That one is optimised
# for a small, immutable artifact: it precompiles assets, drops build tools,
# and sets RAILS_ENV=production. Running it for development means rebuilding
# the image on every code change and losing the debugger — so this one keeps
# the build toolchain, mounts the source, and stays in development mode.
#
# Matches .ruby-version exactly (CLAUDE.md pins the stack).

ARG RUBY_VERSION=3.4.4
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# postgresql-client-18 specifically: `schema_format = :sql` shells out to
# pg_dump, and pg_dump refuses to run against a server newer than itself. The
# Debian default is older than the Postgres 18 we pin in compose, so the
# distribution's client would fail every db:migrate with a version error —
# the same trap CI hit.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git libpq-dev libvips libyaml-dev pkg-config \
      curl ca-certificates gnupg lsb-release && \
    install -d /usr/share/postgresql-common/pgdg && \
    curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc && \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
      https://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update -qq && \
    apt-get install --no-install-recommends -y postgresql-client-18 && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# The PGDG client installs alongside the distribution one; put it first or
# `pg_dump` silently resolves to the older binary.
ENV PATH="/usr/lib/postgresql/18/bin:${PATH}"

ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle" \
    # Bind to all interfaces: localhost inside a container is not reachable
    # from the host.
    BINDING="0.0.0.0"

# Gems install into a named volume (see compose), so this layer only rebuilds
# when the lockfile changes rather than on every source edit.
COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 3000

CMD ["bin/rails", "server", "-b", "0.0.0.0"]
